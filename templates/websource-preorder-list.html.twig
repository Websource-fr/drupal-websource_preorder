{#
/**
 * @file
 * Page « Toutes les précommandes ». Variables : intro, groups (libellé => items).
 */
#}
<div class="wspo-list">
  {% if intro %}<p class="wspo-list__intro">{{ intro }}</p>{% endif %}
  {% for label, items in groups %}
    <section class="wspo-list__group">
      {% if label %}<h2 class="wspo-list__month">{{ label }}</h2>{% endif %}
      <div class="wspo-list__grid">
        {% for item in items %}
          <article class="wspo-card">
            {% if item.image %}<a href="{{ item.url }}"><img src="{{ item.image }}" alt="{{ item.title }}" loading="lazy"></a>{% endif %}
            <div class="wspo-card__body">
              {{ item.badge }}
              <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
              {% if item.release %}<p class="wspo-box__release">{{ 'Sortie le @date'|t({'@date': item.release}) }}</p>{% endif %}
              {{ item.countdown }}
              {% if item.remaining is not null %}<p class="wspo-box__remaining">{{ 'Plus que @n exemplaire(s) disponible(s) en précommande.'|t({'@n': item.remaining}) }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
