{#
/**
 * @file
 * Prochaines précommandes (blocs et pages de compte). Variables : title, text, items.
 */
#}
<section class="wspo-upcoming">
  {% if title %}<h2 class="wspo-upcoming__title">{{ title }}</h2>{% endif %}
  {% if text %}<p>{{ text }}</p>{% endif %}
  <ul class="wspo-upcoming__list">
    {% for item in items %}
      <li>
        <a href="{{ item.url }}">{{ item.title }}</a>
        {% if item.release %}<span class="wspo-upcoming__date">{{ 'Sortie le @date'|t({'@date': item.release}) }}</span>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
